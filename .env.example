# CyberRFP Maroc - Environment Configuration Example

# HTTP Basic Authentication
ADMIN_USER=admin
ADMIN_PASSWORD=cyberrfp2026

# Google AI Studio (Gemini) API Key (Optional: for deep LLM classification and executive French summaries)
# Keyword rules work 100% standalone if no key is provided
GEMINI_API_KEY=

# Local SQLite Database Path or PostgreSQL connection string
DATABASE_PATH=cyberrfp.db
# DATABASE_URL=postgresql://user:password@localhost:5432/cyberrfp

# Alerts Configuration (Email SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_RECIPIENTS=team@cybervendor.ma

# Webhook Alert (Telegram Bot or WhatsApp Bridge)
# For Telegram: https://api.telegram.org/bot<TOKEN>/sendMessage?chat_id=<CHAT_ID>
WEBHOOK_URL=
WEBHOOK_TYPE=telegram

# Application Timezone (Morocco)
TZ=Africa/Casablanca
