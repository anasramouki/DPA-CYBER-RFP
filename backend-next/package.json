    "db:seed": "dotenv -e .env.local -- tsx src/db/seed.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.1",
    "@vercel/functions": "^3.11.3",
    "better-auth": "^1.7.28",
    "cheerio": "^1.2.0",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.81.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.10",
    "@types/react": "^19.3.2",
    "@types/react-dom": "^19.3.0",
    "dotenv-cli": "^11.1.0",
    "drizzle-kit": "^0.31.11",
    "postcss": "^8.5.33",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
